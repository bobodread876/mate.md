{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mate-md.org/schema/mate.schema.json",
  "title": "MATE.md v0.2 frontmatter schema",
  "type": "object",
  "required": [
    "mate_version",
    "subject",
    "object",
    "bond",
    "consent"
  ],
  "properties": {
    "mate_version": {
      "type": "string",
      "pattern": "^0\\.2"
    },
    "subject": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "uri",
            "type"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "uri",
            "type"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "bond": {
      "type": "object",
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "none",
            "proposed",
            "accepted",
            "active",
            "paused",
            "revoked",
            "archived",
            "withdrawn",
            "rejected",
            "expired"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "required": [
        "revocable"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mutual": {
          "type": "boolean"
        },
        "revocable": {
          "type": "boolean"
        },
        "unilateral_exit_allowed": {
          "type": "boolean"
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "withdrawn_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rejected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expired_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "events": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "verificationMethod",
          "created",
          "proofValue"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "verificationMethod": {
            "type": "string"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "ed25519",
              "bip340-schnorr"
            ]
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "proofValue": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "runtime": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "current_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_is_authoritative": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
