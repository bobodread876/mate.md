{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mate-md.org/schema/mate.schema.json",
  "title": "MATE.md frontmatter schema",
  "type": "object",
  "required": [
    "mate_version",
    "subject",
    "object",
    "bond",
    "consent"
  ],
  "properties": {
    "mate_version": {
      "type": "string",
      "pattern": "^0\\.1"
    },
    "subject": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "uri": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "object": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "uri": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "bond": {
      "type": "object",
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "none",
            "proposed",
            "accepted",
            "active",
            "paused",
            "revoked",
            "archived"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "consent": {
      "type": "object",
      "required": [
        "revocable"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mutual": {
          "type": "boolean"
        },
        "revocable": {
          "type": "boolean"
        },
        "unilateral_exit_allowed": {
          "type": "boolean"
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "policies": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "events": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "runtime": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "extensions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}